PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/gul_alem_db
JWT_SECRET=replace-with-long-random-secret
SUPER_ADMIN_EMAIL=admin@example.com

PAYMENT_ENC_KEY=base64-encoded-32-byte-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GMAIL_SERVICE=gmail
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_FROM=your-address@gmail.com
# Optional SMTP override. Leave empty when using GMAIL_SERVICE=gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
RESET_CODE_TTL_MIN=10
RESET_TOKEN_TTL_MIN=30

# Flutter compile-time config. Pass this with:
# flutter run --dart-define=API_BASE_URL=http://127.0.0.1:3000
# Android emulator usually needs http://10.0.2.2:3000 instead.
API_BASE_URL=http://127.0.0.1:3000
