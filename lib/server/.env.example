PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/gul_alem_db
JWT_SECRET=replace-with-long-random-secret
SUPER_ADMIN_EMAIL=admin@example.com

PAYMENT_ENC_KEY=base64-encoded-32-byte-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

SMTP_SERVICE=gmail
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-address@gmail.com
# Optional custom SMTP host override. Leave empty when using SMTP_SERVICE=gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
RESET_CODE_TTL_MIN=10
RESET_TOKEN_TTL_MIN=30
# Keep false in production so reset codes are sent by email.
# Set true only for local/dev fallback when SMTP is unavailable.
RESET_CODE_RESPONSE_FALLBACK=false
# Optional: Render can call this HTTPS tunnel URL, and your computer sends Gmail SMTP.
# If you cannot edit Render env, leave MAIL_RELAY_URL empty and set it through /mail-relay.
# Example MAIL_RELAY_URL: https://your-ngrok-url.ngrok-free.app/send-reset-code
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=replace-with-long-random-token
MAIL_RELAY_TIMEOUT_MS=30000
MAIL_RELAY_PORT=8787
# Optional static ngrok dev domain, without path. Example: example.ngrok-free.app
NGROK_DOMAIN=

# Flutter compile-time config. Pass this with:
# flutter run --dart-define=API_BASE_URL=http://127.0.0.1:3000
# Android emulator usually needs http://10.0.2.2:3000 instead.
API_BASE_URL=http://127.0.0.1:3000
